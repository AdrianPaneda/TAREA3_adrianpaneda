<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity"
    minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0"
    prefWidth="1920.0" xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.adrianpaneda.tarea3AD2024base.controller.DossierArtistasController">

    <!-- ══════════════ CONTENIDO PRINCIPAL ══════════════ -->
    <AnchorPane style="-fx-background-image: url('/images/circo_background.jpg'); -fx-background-size: cover; -fx-background-position: center;">

        <AnchorPane style="-fx-background-color: rgba(0, 0, 0, 0.45);"
            AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <VBox alignment="TOP_CENTER" layoutX="60.0" layoutY="60.0"
                prefHeight="960.0" prefWidth="1800.0" spacing="15.0"
                style="-fx-background-color: rgba(255, 255, 255, 0.98); -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 40, 0, 0, 8);">

                <!-- Cabecera -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="DOSSIERS ARTÍSTICOS" textFill="#7c3aed">
                        <font><Font name="System Bold" size="30.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnVolver" mnemonicParsing="false"
                        onAction="#handleVolver"
                        text="⬅ VOLVER" textFill="white"
                        style="-fx-background-color: #475569; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-font-weight: bold; -fx-font-size: 12; -fx-cursor: hand;" />
                </HBox>
                <Label prefHeight="2.0" prefWidth="1740.0" style="-fx-background-color: #7c3aed;" />

                <!-- Barra de búsqueda -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="Buscar artista:" textFill="#475569"
                        style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                    <TextField fx:id="txtBuscarArtista" prefWidth="300.0" prefHeight="36.0"
                        promptText="Nombre del artista..."
                        style="-fx-background-color: white; -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;" />
                    <Button mnemonicParsing="false"
                        onAction="#handleBuscar"
                        text="BUSCAR" textFill="white"
                        style="-fx-background-color: #7c3aed; -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />
                    <Button mnemonicParsing="false"
                        onAction="#handleLimpiarBusqueda"
                        text="LIMPIAR" textFill="#475569"
                        style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="Artistas:" textFill="#64748b"
                        style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                    <Label fx:id="lblContadorArtistas" text="0"
                        textFill="#7c3aed"
                        style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                </HBox>

                <!-- ScrollPane con cards de artistas -->
                <ScrollPane fitToWidth="true" prefHeight="740.0"
                    hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 1.5; -fx-border-radius: 12;">
                    <VBox fx:id="contenedorCards" spacing="10.0"
                        style="-fx-padding: 12;" />
                </ScrollPane>

                <!-- Botón inferior -->
                <HBox alignment="CENTER">
                    <VBox.margin><Insets top="5.0" /></VBox.margin>
                    <Button fx:id="btnCerrarSesion" mnemonicParsing="false"
                        onAction="#handleCerrarSesion" text="CERRAR SESIÓN"
                        textFill="#475569"
                        style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 22 10 22; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />
                </HBox>

            </VBox>
        </AnchorPane>
    </AnchorPane>

    <!-- ══════════════ OVERLAY MODAL: VALORACIÓN ══════════════ -->
    <StackPane fx:id="overlayValoracion" visible="false" managed="false"
    style="-fx-background-color: rgba(0,0,0,0.5);" alignment="CENTER">
   <VBox maxWidth="520" maxHeight="-Infinity" spacing="14.0"
        StackPane.alignment="CENTER"
        style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 30, 0, 0, 6);">
            <Label fx:id="lblTituloValoracion" text="NUEVA VALORACIÓN" textFill="#92400e"
                style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Label prefHeight="2.0" maxWidth="Infinity" style="-fx-background-color: #f59e0b;">
                <VBox.margin><Insets bottom="6.0" /></VBox.margin>
            </Label>

            <VBox spacing="4.0">
                <Label text="Comentario *" textFill="#475569" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                <TextArea fx:id="txtComentarioValoracion" prefHeight="90.0"
                    promptText="Comentario sobre el artista..."
                    style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
            </VBox>

            <VBox spacing="4.0">
                <Label text="Nivel *" textFill="#475569" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                <ComboBox fx:id="cmbNivelValoracion" prefHeight="38.0" maxWidth="Infinity"
                    promptText="Selecciona nivel"
                    style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
            </VBox>
            
            <Label fx:id="lblErrorValoracion" text="" textFill="#dc2626" style="-fx-font-size: 12px; -fx-font-weight: bold;" />

            <HBox spacing="14.0" alignment="CENTER">
                <VBox.margin><Insets top="10.0" /></VBox.margin>
                <Button text="GUARDAR VALORACIÓN" onAction="#handleGuardarValoracion" textFill="white"
                    style="-fx-background-color: #f59e0b; -fx-background-radius: 8; -fx-padding: 12 32 12 32; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />
                <Button text="CANCELAR" onAction="#handleCancelarValoracion" textFill="#475569"
                    style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-padding: 12 32 12 32; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- ══════════════ OVERLAY MODAL: OBSERVACIÓN ══════════════ -->
   <StackPane fx:id="overlayObservacion" visible="false" managed="false"
    style="-fx-background-color: rgba(0,0,0,0.5);" alignment="CENTER">
 <VBox maxWidth="520" maxHeight="-Infinity" spacing="14.0"
        StackPane.alignment="CENTER"
        style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 35; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 30, 0, 0, 6);">
            <Label fx:id="lblTituloObservacion" text="NUEVA OBSERVACIÓN" textFill="#5b21b6"
                style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <Label prefHeight="2.0" maxWidth="Infinity" style="-fx-background-color: #8b5cf6;">
                <VBox.margin><Insets bottom="6.0" /></VBox.margin>
            </Label>

            <VBox spacing="4.0">
                <Label text="Texto *" textFill="#475569" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                <TextArea fx:id="txtTextoObservacion" prefHeight="90.0"
                    promptText="Observación relevante..."
                    style="-fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" />
            </VBox>

<Label fx:id="lblErrorObservacion" text="" textFill="#dc2626" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <HBox spacing="14.0" alignment="CENTER">
                <VBox.margin><Insets top="10.0" /></VBox.margin>
                <Button text="GUARDAR OBSERVACIÓN" onAction="#handleGuardarObservacion" textFill="white"
                    style="-fx-background-color: #8b5cf6; -fx-background-radius: 8; -fx-padding: 12 32 12 32; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />
                <Button text="CANCELAR" onAction="#handleCancelarObservacion" textFill="#475569"
                    style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-padding: 12 32 12 32; -fx-font-weight: bold; -fx-font-size: 13; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
